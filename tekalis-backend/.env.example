# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tekalis?retryWrites=true&w=majority

# JWT Secret (generate a secure random string for production)
JWT_SECRET=your_secure_jwt_secret_here_min_32_chars

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5174

# Frontend URLs
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:5000

# Admin Configuration
ADMIN_EMAIL=company@tekalis.com

# PayDunya Configuration (for production)
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

# Store Configuration (PayDunya)
STORE_NAME=Tekalis
STORE_TAGLINE=Vente en ligne
STORE_PHONE=221771234567
STORE_ADDRESS=Dakar, Sénégal
STORE_WEBSITE=http://localhost:3001
STORE_LOGO=http://localhost:3001/logo.png

# Email Configuration (SMTP) — noms de variables conformes à services/emailService.js
# EMAIL_PORT=465 → secure:true (SSL) ; 587 → STARTTLS
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=

# ── Google Merchant / Feed ───────────────────────────────────────────────────
# URL publique du site (utilisée dans le feed XML produits)
SITE_URL=

# ── Meta Commerce Manager (Catalog Dynamique) ────────────────────────────────
# ID du catalog créé dans Commerce Manager (cible des campagnes Ads)
META_CATALOG_ID=
# ID du Business Manager propriétaire du catalog
META_BUSINESS_ID=

# ── Meta Conversions API (CAPI) — Events Manager ─────────────────────────────
# ID du pixel Meta (identique à NEXT_PUBLIC_FACEBOOK_PIXEL_ID côté frontend)
META_PIXEL_ID=
# Token d'accès CAPI généré dans Meta Events Manager > Réglages > Conversions API
META_CAPI_ACCESS_TOKEN=
# Version de l'API Graph (rester sur la dernière stable, ex. v21.0)
META_CAPI_VERSION=v21.0
# Code Test Events (TESTXXXXX) pour valider avec l'outil de test avant activation
META_CAPI_TEST_EVENT_CODE=

# ── Google Analytics fallback (sinon, renseigné via admin > Settings > SEO) ──
GA_MEASUREMENT_ID=
