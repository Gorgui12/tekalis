# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tekalis?retryWrites=true&w=majority

# JWT Secret (generate a secure random string for production)
JWT_SECRET=your_secure_jwt_secret_here_min_32_chars

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5174

# Frontend URLs
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:5000

# Admin Configuration
ADMIN_EMAIL=admin@tekalis.com

# PayDunya Configuration (for production)
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

# Store Configuration (PayDunya)
STORE_NAME=Tekalis
STORE_TAGLINE=Vente en ligne
STORE_PHONE=221771234567
STORE_ADDRESS=Dakar, Sénégal
STORE_WEBSITE=http://localhost:3001
STORE_LOGO=http://localhost:3001/logo.png

# Email Configuration (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
