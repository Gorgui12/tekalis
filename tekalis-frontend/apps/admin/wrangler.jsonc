{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tekalis-admin",
  "compatibility_date": "2025-03-25",
  "workers_dev": true,
  "routes": [
    { "pattern": "admin.tekalis.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
