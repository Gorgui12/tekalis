NEXT_PUBLIC_API_BASE=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:5175

# ── Tracking (désactiver la bannière = laisser vide) ────────────────────────
# ID du Pixel Facebook (ex : 1234567890123456)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
# ID Google Analytics 4 (ex : G-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NB : ces IDs peuvent aussi être renseignés depuis l'admin
# (Settings > SEO). La valeur de l'admin a PRIORITÉ sur ces variables ;
# si l'admin les laisse vides, ces variables servent de repli.
