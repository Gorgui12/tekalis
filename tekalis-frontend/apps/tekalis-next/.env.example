NEXT_PUBLIC_API_BASE=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:5175

# ── Connexion avec Google (optionnel) ───────────────────────────────────────
# 1. Console Google Cloud > APIs & Services > Credentials
# 2. "Create credentials" > OAuth client ID > Type "Web application"
# 3. Origines JS autorisées : http://localhost:3000 et https://tekalis.com
#    (redirect URIs ne sont PAS nécessaires : on utilise la popup)
# 4. Coller ici le Client ID, et le MÊME valeur côté API (GOOGLE_CLIENT_ID)
# Si vide → le bouton Google est masqué, le reste fonctionne normalement.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Tracking (désactiver la bannière = laisser vide) ────────────────────────
# ID du Pixel Facebook (ex : 1234567890123456)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
# ID Google Analytics 4 (ex : G-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NB : ces IDs peuvent aussi être renseignés depuis l'admin
# (Settings > SEO). La valeur de l'admin a PRIORITÉ sur ces variables ;
# si l'admin les laisse vides, ces variables servent de repli.
